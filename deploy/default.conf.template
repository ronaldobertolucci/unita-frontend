# Never log query strings or authentication headers.
log_format unita_frontend '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status';

server {
    listen 4200;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    access_log /var/log/nginx/access.log unita_frontend;

    # TLS is terminated by the deployment's ingress/reverse proxy.
    add_header Referrer-Policy no-referrer always;

    location = /assets/env.js {
        add_header Cache-Control "no-store" always;
        add_header Referrer-Policy no-referrer always;
        try_files $uri =404;
    }

    # No URI suffix in proxy_pass: preserve /api and the original query.
    location = /api/notifications/stream {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 24h;
        proxy_next_upstream off;
    }

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $http_host;
        proxy_cache off;
        proxy_next_upstream off;
    }

    location = /api {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $http_host;
        proxy_next_upstream off;
    }

    location /assets/ {
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
